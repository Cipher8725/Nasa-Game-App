[gd_scene load_steps=9 format=3]

; Minijuego de reparación del oxígeno: purga de presión.
;
; El jugador pulsa el botón (ratón o ESPACIO) cuando la aguja de la barra de
; presión está dentro de la zona verde. La estructura de nodos completa está
; aquí; el script solo aporta la lógica.

[ext_resource type="Script" path="res://scripts/minigame_oxygen.gd" id="1_oxygen"]
[ext_resource type="Script" path="res://scripts/repair_gauge.gd" id="2_gauge"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.04, 0.06, 0.11, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.55, 0.8, 0.75)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_bg"]
bg_color = Color(0.12, 0.14, 0.2, 0.9)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_fill"]
bg_color = Color(0.3, 0.75, 0.95, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
bg_color = Color(0.2, 0.55, 0.85, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.75, 0.9, 1, 0.9)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
bg_color = Color(0.3, 0.68, 0.98, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 1, 1, 0.95)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_pressed"]
bg_color = Color(0.14, 0.4, 0.65, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.75, 0.9, 1, 0.9)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="OxygenRepairMinigame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_oxygen")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.68)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -215.0
offset_right = 360.0
offset_bottom = 215.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Body" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Panel/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "REPARACIÓN DE OXÍGENO"
horizontal_alignment = 1

[node name="HintLabel" type="Label" parent="Panel/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.84, 1, 1)
text = "Pulsa ESPACIO o el botón cuando la aguja esté dentro de la zona verde."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Gauge" type="Control" parent="Panel/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(640, 64)
layout_mode = 2
script = ExtResource("2_gauge")

[node name="PressureRow" type="HBoxContainer" parent="Panel/Body"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Name" type="Label" parent="Panel/Body/PressureRow"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "PRESIÓN"

[node name="ProgressBar" type="ProgressBar" parent="Panel/Body/PressureRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_horizontal = 3
max_value = 1.0
value = 0.0
show_percentage = false
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_bar_fill")

[node name="ProgressLabel" type="Label" parent="Panel/Body/PressureRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "0%"
horizontal_alignment = 2

[node name="TimerRow" type="HBoxContainer" parent="Panel/Body"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Name" type="Label" parent="Panel/Body/TimerRow"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
text = "TIEMPO"

[node name="TimerBar" type="ProgressBar" parent="Panel/Body/TimerRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_horizontal = 3
max_value = 20.0
value = 20.0
show_percentage = false
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_bar_fill")

[node name="TimerLabel" type="Label" parent="Panel/Body/TimerRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "20.0 s"
horizontal_alignment = 2

[node name="StatusLabel" type="Label" parent="Panel/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
text = "Pulsa el botón cuando la aguja esté en la zona verde."
horizontal_alignment = 1

[node name="RepairButton" type="Button" parent="Panel/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 58)
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
theme_override_colors/font_color = Color(0.95, 0.99, 1, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("StyleBoxFlat_button")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_button_pressed")
theme_override_styles/focus = SubResource("StyleBoxFlat_button_hover")
text = "PULSA (ESPACIO)"

[node name="ResultPanel" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="ResultPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.55)

[node name="Box" type="VBoxContainer" parent="ResultPanel"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -80.0
offset_right = 320.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="ResultTitle" type="Label" parent="ResultPanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "REPARACIÓN COMPLETADA"
horizontal_alignment = 1

[node name="ResultDetail" type="Label" parent="ResultPanel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.88, 1, 1)
text = "Sistema restablecido."
horizontal_alignment = 1
