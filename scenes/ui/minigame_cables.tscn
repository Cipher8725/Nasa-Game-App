[gd_scene load_steps=13 format=3]

; Minijuego de reparación de la energía: conectar cables.
;
; A la izquierda hay cuatro cables de colores distintos y a la derecha cuatro
; conectores desordenados. El jugador pulsa un cable y después su conector.
; Las líneas de los cables conectados se dibujan en la capa "WireLayer".

[ext_resource type="Script" path="res://scripts/minigame_cables.gd" id="1_cables"]
[ext_resource type="Script" path="res://scripts/cable_wire_layer.gd" id="2_wire"]

