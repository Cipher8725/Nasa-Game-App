[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mission_controller.gd" id="1_controller"]
[ext_resource type="PackedScene" path="res://scenes/habitat.tscn" id="2_habitat"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://scenes/emergency_system.tscn" id="5_emergency"]

[node name="Main" type="Node3D"]
script = ExtResource("1_controller")

[node name="Habitat" parent="." instance=ExtResource("2_habitat")]

[node name="Player" parent="." instance=ExtResource("3_player")]
unique_name_in_owner = true
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 4)

[node name="EmergencySystem" parent="." instance=ExtResource("5_emergency")]

[node name="UILayer" type="CanvasLayer" parent="."]

[node name="HUD" parent="UILayer" instance=ExtResource("4_hud")]
