; ─────────────────────────────────────────────────────────────
; Colisiones. Una caja por panel de pared. Las puertas se parten en
; dos tramos para dejar un hueco de 1,6 m (o 1,6 m en el eje Z).
;
; Puerta NORTE (x = 0) · puertas SUR (x = -8, 0, +8) · puerta OESTE y
; puerta ESTE (z = 0).
; ─────────────────────────────────────────────────────────────
[node name="Floor" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 1

[node name="FloorCollision" type="CollisionShape3D" parent="Floor"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.2, 0)
shape = SubResource("BoxShape3D_floor")

