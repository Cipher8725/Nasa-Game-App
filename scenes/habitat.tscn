[gd_scene load_steps=14 format=3]

; Módulo habitable de la estación espacial.
;
; La estación se apoya sobre un gran bloque (StationPlatform) de material sólido.
; La geometría del módulo viene de `scenes/habitat_decor.tscn` y las consolas de
; `scenes/console.tscn`.
; El cielo es una panorámica realista (`resources/sky_space_material.tres`).
;
; FÍSICA: las paredes del pack son solo visuales; aquí están las cajas de
; colisión invisibles. Cada pared se modela con una caja por panel y las
; puertas se parten en dos tramos, de forma que los huecos quedan transitables
; (si no, una puerta invisible cerraba el paso a las salas).

[ext_resource type="Script" path="res://scripts/habitat.gd" id="1_habitat"]
[ext_resource type="PackedScene" path="res://scenes/console.tscn" id="2_console"]
[ext_resource type="PackedScene" path="res://scenes/habitat_decor.tscn" id="3_decor"]
[ext_resource type="PackedScene" path="res://scenes/station_platform.tscn" id="4_platform"]
