; Sol: ilumina la cara de los planetas que mira al módulo (viaja hacia +Z).
[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.954480, 0, 0.298275, 0.163643, 0.836065, 0.523657, -0.249377, 0.548630, -0.798007, 0, 12, 0)
light_energy = 1.05
shadow_enabled = true

; Relleno: luz suave desde el lado opuesto (sin sombras) para que las caras
; en sombra de los modelos no queden negras.
[node name="FillLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.972806, 0, -0.231621, -0.116066, 0.865387, -0.487477, 0.200441, 0.501104, 0.841854, 0, 8, 0)
light_energy = 0.3
shadow_enabled = false

; Iluminación interior: una lámpara por luminaria del techo. Sin sombras para
; mantener el coste bajo (el módulo ya recibe sombra direccional).
[node name="InteriorLights" type="Node3D" parent="."]

