[node name="MoonHint" type="Label" parent="Layout/LevelPanel/LevelBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.92, 0.68, 1)
theme_override_font_sizes/font_size = 17
text = "Nivel disponible · 3 minutos de misión"
