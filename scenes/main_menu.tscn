[connection signal="pressed" from="Layout/MainPanel/MainBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Layout/MainPanel/MainBox/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="Layout/LevelPanel/LevelBox/MoonButton" to="." method="_on_moon_pressed"]
[connection signal="pressed" from="Layout/LevelPanel/LevelBox/MarsButton" to="." method="_on_mars_pressed"]
[connection signal="pressed" from="Layout/LevelPanel/LevelBox/BackButton" to="." method="_on_back_pressed"]
