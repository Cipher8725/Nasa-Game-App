; ─────────────────────────────────────────────────────────────
; AMPLIACIÓN DE LA ESTACIÓN (hito de accesibilidad)
; ─────────────────────────────────────────────────────────────
; Tres puertas nuevas en la pared sur del módulo central (x = -8, 0, +8)
; dan paso a las nuevas salas. Cada pasillo es un módulo corridor_module sin
; rotar: su tubo queda en x = centro + 2,09 y mide 8,14 m de largo.


; Sala de oxígeno: al sur de la sala del generador (puerta en su pared oeste).
; La posición alinea su puerta exactamente con la del generador (-27,58 / -1,99).
[node name="RoomOxygen" parent="." instance=ExtResource("26_oxigeno")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -27.58, 0, -11.59)

; ─────────────────────────────────────────────────────────────
; CADENA DE SALAS NUEVAS (al norte de la estación)
; ─────────────────────────────────────────────────────────────
; Las salas miden 20 x 20 m, así que se encadenan con pasillos para que no se
; solapen entre sí:
;   cuartos → pasillo → sala de reuniones → pasillo → enfermería → pasillo →
;   hidroponía (la sala más alejada del centro de la estación)

