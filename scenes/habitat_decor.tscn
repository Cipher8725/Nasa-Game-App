; Orrery: centro de mando del módulo. Se coloca a la izquierda del pasillo
; central (x = -3.2) para no tapar ni el ventanal ni el camino hacia las
; consolas, que discurre por x = 0.
[node name="Orrery" parent="Props" instance=ExtResource("15_orrery")]
transform = Transform3D(0.85, 0, 0, 0, 0.85, 0, 0, 0, 0.85, -3.2, 0, 0.6)

