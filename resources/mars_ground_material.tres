[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Regolita marciana (RESERVADA, NO USADA).
;
; El suelo interior usa desde el Hito 12 el material ORIGINAL del pack Molten
; Maps: ni esta regolita ni la lunar se cargan en el juego. Este `.tres` se
; conserva para el futuro nivel de Marte del menú principal (hoy bloqueado en
; `scenes/main_menu.tscn`).
;
; Si se recupera: asignarlo a `floor_material` del nodo `StationInterior` de
; `scenes/habitat_decor.tscn` y poner `enabled = true` en ese mismo nodo.
;
; La proyección es triplanar en espacio de mundo (`uv1_world_triplanar`): así la
; textura es continua entre baldosas, salas y pasillos, y no se repite una vez
; por baldosa. `uv1_scale = 0.2` equivale a una baldosa de textura cada 5 m.

[ext_resource type="Texture2D" path="res://ai_assets/textures/mars_regolith.webp" id="1_albedo"]
[ext_resource type="Texture2D" path="res://ai_assets/textures/mars_regolith_normal.webp" id="2_normal"]

[resource]
resource_name = "MarsRegolith"
albedo_texture = ExtResource("1_albedo")
metallic = 0.0
roughness = 0.96
normal_enabled = true
normal_texture = ExtResource("2_normal")
normal_scale = 0.85
uv1_triplanar = true
uv1_world_triplanar = true
uv1_scale = Vector3(0.2, 0.2, 0.2)
texture_filter = 5
