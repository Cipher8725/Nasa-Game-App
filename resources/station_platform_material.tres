[gd_resource type="StandardMaterial3D" format=3]

; Material del cubo base de la estación (`StationPlatform/BaseCube`).
;
; Material SÓLIDO, sin texturas: el proyecto ya no carga las regolitas
; generadas con IA (`ai_assets/textures/moon_regolith*.webp` ni
; `mars_regolith*.webp`) en ninguna superficie.
;
; El cubo es decorado: la iluminación direccional + el relleno le dan el
; volumen, y al ser una superficie enorme una textura repetida se notaría
; más que un color plano. Si en el futuro se quiere detalle, crear un
; material nuevo y asignarlo en `scenes/station_platform.tscn`.

[resource]
resource_name = "StationPlatformMetal"
albedo_color = Color(0.42, 0.44, 0.48, 1)
metallic = 0.15
roughness = 0.92
