[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Regolita lunar para el cubo base de la estación (StationPlatform/BaseCube).
;
; Textura generada con IA y procesada con `tools/process_ai_textures.py`
; (repetible sin costuras). El mapa de normales da relieve a los cráteres con la
; luz del sol.
;
; `uv1_scale = 12` reparte 12 repeticiones por cara del cubo de 60 m, es decir
; una baldosa de textura cada 5 m. Si se cambia el tamaño del cubo hay que
; ajustar la escala para mantener esa densidad.

[ext_resource type="Texture2D" path="res://ai_assets/textures/moon_regolith.webp" id="1_albedo"]
[ext_resource type="Texture2D" path="res://ai_assets/textures/moon_regolith_normal.webp" id="2_normal"]

[resource]
resource_name = "StationPlatformMoon"
albedo_texture = ExtResource("1_albedo")
metallic = 0.0
roughness = 0.96
normal_enabled = true
normal_texture = ExtResource("2_normal")
normal_scale = 0.85
uv1_scale = Vector3(12, 12, 1)
texture_filter = 5
